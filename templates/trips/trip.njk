{% set t = tripUi[lang] %}
<article class="trip">
  <p class="trip-back"><a href="/{{ t.langPrefix }}trips/index.html">← {{ t.allTrips }}</a></p>
  <h1>{{ trip.title }}</h1>
  {% if trip.dateRange or trip.distanceKm %}
  <p class="trip-dates">
    {% if trip.dateRange %}{{ trip.dateRange }}{% endif %}
    {% if trip.dateRange and trip.distanceKm %} · {% endif %}
    {% if trip.distanceKm %}{{ trip.distanceKm }}{% endif %}
  </p>
  {% endif %}

  {% set related = tripBacklinks[lang][trip.slug] %}
  {% if related and related.length %}
  <section class="trip-relevant-posts">
    <h2>{{ t.relevantPosts }}</h2>
    <ul>
      {% for post in related %}
      <li><a href="{{ post.url }}">{{ post.title }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <div class="trip-layout">
    <div class="trip-map-column">
      <div class="trip-map-wrap">
        <div class="trip-chevron-bar">
          <button
            type="button"
            class="trip-chevron trip-chevron--map"
            data-toggle-section="map"
            aria-label="{{ t.hideMap }}"
            title="{{ t.hideMap }}"
          >‹</button>
          <button
            type="button"
            class="trip-map-thumbs-toggle"
            aria-pressed="true"
            aria-label="{{ t.mapThumbsLabel }}"
            title="{{ t.hideMapThumbs }}"
            data-title-on="{{ t.hideMapThumbs }}"
            data-title-off="{{ t.showMapThumbs }}"
          >▣</button>
          <button
            type="button"
            class="trip-chevron trip-chevron--show-photos"
            data-toggle-section="photos"
            aria-label="{{ t.showPhotos }}"
            title="{{ t.showPhotos }}"
            hidden
          >‹</button>
        </div>
        <div class="trip-map-frame">
          <div
            id="trip-map-{{ trip.slug }}"
            class="trip-map"
            data-bounds='{{ trip.boundsJson | safe }}'
            data-tiles="{{ trip.tileUrlTemplate }}"
            data-zoom="{{ trip.tileZoom }}"
            data-tracks="{{ trip.tracksJsonUrl }}"
            data-photos='{{ trip.mapPhotosJson | safe }}'
          ></div>
        </div>
      </div>

      {% if trip.tracks and trip.tracks.length %}
      <ul class="trip-gpx-list">
        {% for track in trip.tracks %}
        <li>
          <span class="trip-track-swatch" style="background:{{ track.color }}"></span>
          <a href="{{ track.gpxUrl }}" download>{{ track.filename }}</a>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>

    <div class="trip-photos-column">
      <div class="trip-photos-wrap">
        <div class="trip-chevron-bar">
          <button
            type="button"
            class="trip-chevron trip-chevron--show-map"
            data-toggle-section="map"
            aria-label="{{ t.showMap }}"
            title="{{ t.showMap }}"
            hidden
          >›</button>
          <button
            type="button"
            class="trip-chevron trip-chevron--photos"
            data-toggle-section="photos"
            aria-label="{{ t.hidePhotos }}"
            title="{{ t.hidePhotos }}"
          >›</button>
        </div>
        <div class="trip-photos-stage">
          <div class="trip-photo-grid">
            {% for photo in trip.photos %}
            <a
              class="trip-photo-grid-item"
              href="{{ photo.photoPageUrl }}"
              data-photo-url="{{ photo.photoPageUrl }}"
              data-display-url="{{ photo.displayUrl }}"
              data-original-url="{{ photo.originalUrl }}"
              data-filename="{{ photo.filename }}"
              data-original-size="{{ photo.originalSize }}"
              data-exif-line="{{ photo.exifLine }}"
              data-photo-index="{{ loop.index0 }}"
              title="{{ photo.exifTooltip }}"
            >
              <img src="{{ photo.gridThumbUrl }}" alt="" loading="lazy" />
            </a>
            {% endfor %}
          </div>
          <a class="trip-photo-hover-preview">
            <img alt="" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <dialog class="trip-photo-modal" id="trip-photo-modal" aria-label="Фото">
    <div class="trip-modal-bar">
      <button type="button" class="trip-modal-close" aria-label="{{ t.close }}" title="{{ t.close }}">✕</button>
    </div>
    <div class="trip-modal-single">
      <button type="button" class="trip-modal-nav trip-modal-prev" aria-label="{{ t.prevPhoto }}" title="{{ t.prevPhoto }}">‹</button>
      <figure class="trip-modal-single-figure">
        <img class="trip-modal-single-img" alt="" />
        <figcaption class="trip-modal-single-caption">
          <div class="trip-modal-single-exif"></div>
          <div class="trip-modal-single-meta">
            <a id="trip-modal-page-link" href="" target="_self" aria-label="{{ t.photoPage }}">{{ t.photoPage }} 🔗</a>
            ·
            <a class="trip-modal-single-download"></a>
            <span class="trip-modal-single-pos"></span>
          </div>
        </figcaption>
      </figure>
      <button type="button" class="trip-modal-nav trip-modal-next" aria-label="{{ t.nextPhoto }}" title="{{ t.nextPhoto }}">›</button>
    </div>
    <div class="trip-modal-feed">
      {% for photo in trip.photos %}
      <figure class="trip-modal-feed-item" data-photo-id="{{ photo.id }}" data-photo-index="{{ loop.index0 }}" data-photo-url="{{ photo.photoPageUrl }}">
        <img class="trip-modal-feed-img" data-src="{{ photo.displayUrl }}" alt="" loading="lazy" />
        <figcaption class="trip-modal-feed-caption">
          {% if photo.exifLine %}
          <div class="trip-modal-feed-exif">{{ photo.exifLine }}</div>
          {% endif %}
          <div class="trip-modal-feed-meta">
            <a href="{{ photo.photoPageUrl }}">{{ t.photoPage }} 🔗</a>
            ·
            <a href="{{ photo.originalUrl }}" download="{{ photo.filename }}">{{ photo.filename }} ({{ photo.originalSize }})</a>
          </div>
        </figcaption>
      </figure>
      {% endfor %}
    </div>
  </dialog>
</article>

<script src="/vendor/leaflet/leaflet.js"></script>
<script src="/js/trip.js"></script>

---
permalink: /atom-all.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.feedTitle | safe }}</title>
  <link href="{{ rootUrl }}/atom-all.xml" rel="self" />
  <link href="{{ rootUrl }}/" />
  <updated>{{ collections.postsAll | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ rootUrl }}/atom-all.xml</id>
  <author>
    <name>{{ site.feedAuthorName }}</name>
    <email>{{ site.email }}</email>
  </author>
  {%- for post in collections.postsAll | head(20) %}
  {% set absolutePostUrl %}{{ post.url | absoluteUrl(rootUrl) }}{% endset %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absolutePostUrl }}" />
    <id>{{ absolutePostUrl }}</id>
    <published>{{ post.data.isoDate }}T00:00:00Z</published>
    <updated>{{ post.data.updated }}</updated>
    <summary type="html"><![CDATA[{{ post.data.contentHtml | safe }}]]></summary>
  </entry>
  {%- endfor %}
</feed>

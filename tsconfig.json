{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "eleventy.config.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "_data/**/*.ts",
    "**/*.11tydata.ts"
  ]
}

{% set t = tripUi[lang] %}
<article class="all-photos">
  <h1>{{ t.allPhotos }}</h1>

  <div
    class="photo-gallery"
    data-photo-gallery
    data-photos-catalog="/{{ t.langPrefix }}photos/catalog.json"
  >
    {# Page 1 = oldest chunk; within each page show newest first (older at bottom). #}
    {% set photos = pagination.items | reverse %}
    {% set indexOffset = pagination.pageNumber * pagination.size %}
    {% set indexNewestFirst = true %}
    {% include "photos/grid.njk" %}
    {% include "photos/modal.njk" %}
  </div>
</article>

{% if pagination.pages.length > 1 %}
<footer id="neighbour-links">
  <nav>
    {% if pagination.href.previous %}
    <span style="float: left;">
      <a class="page-link" rel="prev" href="{{ pagination.href.previous }}">←</a>
    </span>
    {% endif %}

    <div style="display: inline-block; text-align: center;">{{ pagination.pageNumber + 1 }}/{{ pagination.pages.length }}</div>

    {% if pagination.href.next %}
    <span style="float: right;">
      <a class="page-link" rel="next" href="{{ pagination.href.next }}">→</a>
    </span>
    {% endif %}
  </nav>
</footer>
<script>
(function () {
  var nav = document.getElementById("neighbour-links");
  if (!nav) return;
  var prev = nav.querySelector('a[rel="prev"]');
  var next = nav.querySelector('a[rel="next"]');
  if (!prev && !next) return;

  function modalOpen() {
    var modal = document.getElementById("trip-photo-modal");
    return !!(modal && (modal.open || modal.hasAttribute("open")));
  }

  document.addEventListener("keydown", function (e) {
    if (modalOpen()) return;
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
    var target = e.target;
    var tagName = target && target.tagName;
    if (
      tagName === "INPUT" ||
      tagName === "TEXTAREA" ||
      tagName === "SELECT" ||
      (target && target.isContentEditable)
    ) {
      return;
    }
    if (e.key === "ArrowLeft" || e.keyCode === 37) {
      if (prev && prev.href) location.href = prev.href;
    } else if (e.key === "ArrowRight" || e.keyCode === 39) {
      if (next && next.href) location.href = next.href;
    }
  });
})();
</script>
{% endif %}

<script src="/js/trip.js"></script>

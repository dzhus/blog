{# Expects: photos (array for initial feed), t (tripUi), optional indexOffset #}
{% set indexOffset = indexOffset or 0 %}
<dialog class="trip-photo-modal" id="trip-photo-modal" aria-label="{{ t.allPhotos }}">
  <div class="trip-modal-bar">
    <button type="button" class="trip-modal-close" aria-label="{{ t.close }}" title="{{ t.close }}">✕</button>
  </div>
  <div class="trip-modal-single">
    <button type="button" class="trip-modal-nav trip-modal-prev" aria-label="{{ t.prevPhoto }}" title="{{ t.prevPhoto }}">‹</button>
    <figure class="trip-modal-single-figure">
      <img class="trip-modal-single-img" alt="" />
      <figcaption class="trip-modal-single-caption">
        <div class="trip-modal-single-exif"></div>
        <div class="trip-modal-single-meta">
          <a id="trip-modal-page-link" href="" target="_self" aria-label="{{ t.photoPage }}">{{ t.photoPage }} 🔗</a>
          ·
          <a class="trip-modal-single-download"></a>
          <span class="trip-modal-single-pos"></span>
        </div>
      </figcaption>
    </figure>
    <button type="button" class="trip-modal-nav trip-modal-next" aria-label="{{ t.nextPhoto }}" title="{{ t.nextPhoto }}">›</button>
  </div>
  <div class="trip-modal-feed">
    {% for photo in photos %}
    <figure
      class="trip-modal-feed-item"
      data-photo-id="{{ photo.id }}"
      data-photo-index="{% if indexNewestFirst %}{{ indexOffset + photos.length - 1 - loop.index0 }}{% else %}{{ indexOffset + loop.index0 }}{% endif %}"
      data-photo-url="{{ photo.photoPageUrl }}"
    >
      <img class="trip-modal-feed-img" data-src="{{ photo.displayUrl }}" alt="" loading="lazy" />
      <figcaption class="trip-modal-feed-caption">
        {% if photo.exifLine %}
        <div class="trip-modal-feed-exif">{{ photo.exifLine }}</div>
        {% endif %}
        <div class="trip-modal-feed-meta">
          <a href="{{ photo.photoPageUrl }}">{{ t.photoPage }} 🔗</a>
          ·
          <a href="{{ photo.originalUrl }}" download="{{ photo.filename }}">{{ photo.filename }} ({{ photo.originalSize }})</a>
        </div>
      </figcaption>
    </figure>
    {% endfor %}
  </div>
</dialog>

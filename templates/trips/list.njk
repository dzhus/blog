{% set t = tripUi[lang] %}
{% set totals = tripsList | tripsTotals(lang) %}
<article class="trips-index">
  <h1>{{ t.listTitle }}</h1>
  {% if totals.distanceKm or totals.ascentLabel %}
  <p class="trips-totals">
    {% if totals.distanceKm %}{{ t.totalDistance }}: {{ totals.distanceKm }}{% endif %}
    {% if totals.distanceKm and totals.ascentLabel %} · {% endif %}
    {% if totals.ascentLabel %}{{ t.totalAscent }}: {{ totals.ascentLabel }}{% endif %}
  </p>
  {% endif %}
  {% if tripsList and tripsList.length %}
  <ul class="trips-list">
    {% for trip in tripsList %}
    <li>
      <a class="trips-list-link" href="{{ trip.url }}">
        {% if trip.coverThumbUrl %}
        <span class="trips-list-thumb">
          <img src="{{ trip.coverThumbUrl }}" alt="" width="120" height="120" loading="lazy" />
        </span>
        {% endif %}
        <span class="trips-list-meta">
          <span class="trips-list-title">{{ trip.title }}</span>
          {% if trip.dateRange or trip.distanceKm or trip.ascentLabel or trip.maxElevationLabel %}
          <span class="trips-list-period">
            {% if trip.dateRange %}
            <span class="trips-list-dates">{{ trip.dateRange }}</span>
            {% endif %}
            {% if trip.distanceKm or trip.ascentLabel or trip.maxElevationLabel %}
            <span class="trips-list-stats">
              {% if trip.distanceKm %}{{ trip.distanceKm }}{% endif %}
              {% if trip.distanceKm and trip.ascentLabel %} · {% endif %}
              {% if trip.ascentLabel %}{{ trip.ascentLabel }}{% endif %}
              {% if (trip.distanceKm or trip.ascentLabel) and trip.maxElevationLabel %} · {% endif %}
              {% if trip.maxElevationLabel %}{{ trip.maxElevationLabel }}{% endif %}
            </span>
            {% endif %}
          </span>
          {% endif %}
          <span class="trips-list-counts">{{ t.photoCount(trip.photoCount) }}{% if trip.trackCount %}{{ t.countsJoiner }}{{ t.trackCount(trip.trackCount) }}{% endif %}</span>
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p>{{ t.listEmpty }}</p>
  {% endif %}
</article>
